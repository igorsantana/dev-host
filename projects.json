{
  "developmentRoot": "..",
  "hostPort": 4040,
  "syncRepos": [
    {
      "path": "cyberdeck-ui",
      "name": "Cyberdeck UI",
      "repository": "https://github.com/igorsantana/cyberdeck-ui.git",
      "branch": "main"
    }
  ],
  "projects": [
    {
      "id": "personal-planner",
      "name": "Personal Planner",
      "description": "Live calendar console with category filters and SP timezone.",
      "path": "personal-planner",
      "image": "/images/personal-planner.svg",
      "runtime": "docker",
      "port": 5173,
      "url": "http://localhost:5173",
      "healthCheck": { "type": "http", "url": "http://127.0.0.1:5173" }
    },
    {
      "id": "projeto",
      "name": "Finance News",
      "description": "Pipeline, reports, trends, and LLM investment advisor.",
      "path": "Projeto",
      "repository": "https://github.com/igorsantana/finance-sentiment.git",
      "branch": "develop",
      "image": "/images/projeto.svg",
      "runtime": "docker",
      "port": 5173,
      "url": "http://localhost:5173",
      "web": { "path": "web", "startScript": "dev" },
      "healthCheck": { "type": "http", "url": "http://127.0.0.1:5173" },
      "apiHealthCheck": { "type": "http", "url": "http://127.0.0.1:8000/api/health" }
    },
    {
      "id": "vinyl-catalog",
      "name": "Vinyl Catalog",
      "description": "Next.js catalog with AI scan and record management.",
      "path": "vinyl-catalog",
      "repository": "https://github.com/igorsantana/vinyl-collector.git",
      "branch": "develop",
      "image": "/images/vinyl-catalog.svg",
      "runtime": "npm",
      "port": 3000,
      "url": "http://localhost:3000",
      "startScript": "dev",
      "healthCheck": { "type": "http", "url": "http://127.0.0.1:3000" }
    }
  ]
}
